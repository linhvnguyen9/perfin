CREATE TABLE IF NOT EXISTS TransactionsEntity (
    transaction_id TEXT PRIMARY KEY NOT NULL,
    account_id TEXT NOT NULL,
    amount TEXT NOT NULL,
    title TEXT NOT NULL,
    date INTEGER NOT NULL,
    is_reconciled INTEGER NOT NULL DEFAULT 0, -- Boolean as INTEGER 0/1
    notes TEXT,
    location TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (account_id) REFERENCES AccountEntity(account_id)
);

getAllTransactions:
SELECT *
FROM TransactionsEntity
ORDER BY date DESC;

getAllTransactionsByAccount:
SELECT *
FROM TransactionsEntity
WHERE account_id = :accountId
ORDER BY date DESC;

getRecentTransactions:
SELECT *
FROM TransactionsEntity
ORDER BY date DESC
LIMIT :limit OFFSET :offset;

searchTransactions:
SELECT *
FROM TransactionsEntity
WHERE title LIKE '%' || :query || '%'
ORDER BY date DESC;

getUnreconciledTransactions:
SELECT *
FROM TransactionsEntity
WHERE account_id = :accountId
AND is_reconciled = 0
ORDER BY date DESC;

updateReconciliationStatus:
UPDATE TransactionsEntity
SET is_reconciled = :isReconciled,
    updated_at = :currentTimestamp
WHERE transaction_id = :transactionId;

getTransactionsByDateRange:
SELECT *
FROM TransactionsEntity
WHERE date BETWEEN :startDate AND :endDate
ORDER BY date DESC;

getTransactionById:
SELECT *
FROM TransactionsEntity
WHERE transaction_id = :transactionId;

deleteTransaction:
DELETE FROM TransactionsEntity
WHERE transaction_id = :transactionId;

updateTransaction:
UPDATE TransactionsEntity
SET
    amount = :amount,
    title = :title,
    date = :date,
    notes = :notes,
    location = :location,
    updated_at = :currentTimestamp
WHERE transaction_id = :transactionId;

updateTransactionName:
UPDATE TransactionsEntity
SET
    title = :title,
    updated_at = strftime('%s', 'now')
WHERE transaction_id = :transaction_id;

insertTransaction:
INSERT INTO TransactionsEntity (
    transaction_id,
    account_id,
    amount,
    title,
    date,
    is_reconciled,
    notes,
    location,
    created_at,
    updated_at
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
);