CREATE TABLE IF NOT EXISTS CategoryEntity (
    category_id TEXT PRIMARY KEY NOT NULL,
    parent_category_id TEXT,
    name TEXT NOT NULL,
    icon TEXT,
    color TEXT,
    is_income INTEGER NOT NULL DEFAULT 0, -- Boolean as INTEGER 0/1
    is_system INTEGER NOT NULL DEFAULT 0, -- Boolean as INTEGER 0/1
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (parent_category_id) REFERENCES CategoryEntity(category_id)
);

-- Get all categories
getAllCategories:
SELECT * FROM CategoryEntity ORDER BY name ASC;

-- Get category by ID
getCategoryById:
SELECT * FROM CategoryEntity WHERE category_id = ?;

-- Get categories by income type
getCategoriesByType:
SELECT * FROM CategoryEntity WHERE is_income = ? ORDER BY name ASC;

-- Get system categories
getSystemCategories:
SELECT * FROM CategoryEntity WHERE is_system = 1 ORDER BY name ASC;

-- Get user categories  
getUserCategories:
SELECT * FROM CategoryEntity WHERE is_system = 0 ORDER BY name ASC;

-- Insert new category
insertCategory:
INSERT INTO CategoryEntity (
    category_id,
    parent_category_id,
    name,
    icon,
    color,
    is_income,
    is_system,
    created_at,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update existing category
updateCategory:
UPDATE CategoryEntity SET
    parent_category_id = ?,
    name = ?,
    icon = ?,
    color = ?,
    is_income = ?,
    is_system = ?,
    updated_at = ?
WHERE category_id = ?;

-- Delete category
deleteCategory:
DELETE FROM CategoryEntity WHERE category_id = ?;